# Copy to .env and insert the complete private credentials locally.
MQTT_BROKER_HOST=replace-with-portal-value
MQTT_BROKER_PORT=1883
MQTT_USERNAME=TEAM_2
MQTT_PASSWORD=replace-with-full-password
MQTT_TOPIC=hackathon/team_2/test/telemetry

# Verified broker connection used by the application.
MQTT_ENDPOINT_HOST=mqtt-hackathon.lexatek.vn
MQTT_ENDPOINT_PORT=443
MQTT_TRANSPORT=websockets
MQTT_WEBSOCKET_PATH=/mqtt
MQTT_TLS=true
MQTT_KEEPALIVE_SECONDS=30
MQTT_CLIENT_ID_PREFIX=farmops-team-2

API_HOST=127.0.0.1
API_PORT=8000
STALE_AFTER_SECONDS=60
DATABASE_PATH=farmops.db
