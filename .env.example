# Copy this file to .env and fill in your own secrets locally.
# Never commit the real .env file.

# API
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=farmops.db
STALE_AFTER_SECONDS=300

# MQTT
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=443
MQTT_TRANSPORT=tcp
MQTT_TLS=false
MQTT_USERNAME=TEAM_2
MQTT_PASSWORD=
MQTT_TOPIC=hackathon/team_2/test/telemetry

# Optional MongoDB
MONGODB_URI=
MONGODB_DB_NAME=farmops

# LLM keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_2_API_KEY=
GEMINI_2_MODEL=gemini-3.5-flash
GPT_OSS_API_KEY=
GPT_OSS_MODEL=openai/gpt-oss-120b
GPT_OSS_BASE_URL=https://openrouter.ai/api/v1
GPT_OSS_2_API_KEY=
GPT_OSS_2_MODEL=openai/gpt-oss-120b
GPT_OSS_2_BASE_URL=https://openrouter.ai/api/v1
