{
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "extraPaths": [
    ".venv-site-packages"
  ],
  "include": [
    "src",
    "tests",
    "scripts"
  ],
  "exclude": [
    ".venv",
    ".venv-site-packages",
    "**/__pycache__",
    "**/__pyrefly_virtual__"
  ],
  "typeCheckingMode": "basic",
  "useLibraryCodeForTypes": true,
  "reportMissingModuleSource": "none",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none",
  "reportParseError": "none"
}
